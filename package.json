{
  "name": "eddie-at-bangmod",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
      "typescript": "^6.0.3",
      "varlock": "1.25.0",
      "lucide-react": "^1.72.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.5",
      "@libsql/client": "0.18.0",
      "libsql": "0.5.29",
      "@orpc/server": "^1.16.2",
      "@orpc/client": "^1.16.2",
      "@orpc/openapi": "^1.16.2",
      "@orpc/zod": "^1.16.2",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev:bare",
    "db:generate": "vp run --filter @eddie-at-bangmod/db db:generate",
    "deploy": "vp run --filter @eddie-at-bangmod/infra deploy",
    "destroy": "vp run --filter @eddie-at-bangmod/infra destroy",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@eddie-at-bangmod/config": "workspace:*",
    "@types/node": "^26.6.6",
    "rolldown": "1.3.2",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vite": "catalog:",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "packageManager": "bun@1.4.4"
}
